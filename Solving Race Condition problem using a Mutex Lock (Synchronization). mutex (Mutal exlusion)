#include <iostream>
#include <thread>
#include <mutex>
using namespace std;

mutex lock;
int count = 0;

void task()
{
    lock.lock();

    for (int i = 0; i < 10000000; i++)
    {
        count += 1;
    }

    lock.unlock();
}

int main()
{
    thread t1(task);
    thread t2(task);

    t1.join();
    t2.join();

    cout << count << endl;

    return 0;
}
