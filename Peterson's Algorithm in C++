#include <iostream>
#include <thread>
using namespace std;

bool flag[2] = {false, false};
int turn;
int count = 0;

void task(int id)
{
    int other = 1 - id;

    flag[id] = true;
    turn = other;

    while (flag[other] && turn == other);

    // Critical section
    count++;

    flag[id] = false;
}

int main()
{
    thread t1(task, 0);
    thread t2(task, 1);

    t1.join();
    t2.join();

    cout << count << endl;
    return 0;
}
