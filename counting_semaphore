#include <iostream>
#include <semaphore>
#include <thread>
using namespace std;

counting_semaphore<3> S(3);

void work(int id) {
    S.acquire();  // wait()

    cout << "Thread " << id
         << " entered the critical section\n";

    this_thread::sleep_for(chrono::seconds(1));

    cout << "Thread " << id
         << " leaving the critical section\n";

    S.release();  // signal()
}

int main() {
    thread t1(work, 1);
    thread t2(work, 2);
    thread t3(work, 3);
    thread t4(work, 4);
    thread t5(work, 5);

    t1.join();
    t2.join();
    t3.join();
    t4.join();
    t5.join();

    return 0;
}
