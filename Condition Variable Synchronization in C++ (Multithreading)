#include <iostream>
#include <thread>
#include <mutex>
#include <condition_variable>
#include <chrono>
using namespace std;

mutex m;
condition_variable cond;
int done = 1;

void task(string name)
{
    unique_lock<mutex> lock(m);

    if (done == 1)
    {
        done = 2;

        cout << "Waiting on condition variable: " << name << endl;
        cond.wait(lock);

        cout << "Condition met: " << name << endl;
    }
    else
    {
        lock.unlock();

        for (int i = 0; i < 5; i++)
        {
            cout << ".";
            this_thread::sleep_for(chrono::seconds(1));
        }

        cout << "\nSignaling condition variable: " << name << endl;
        cond.notify_all();

        cout << "Notification done: " << name << endl;
    }
}

int main()
{
    thread t1(task, "t1");
    thread t2(task, "t2");

    t1.join();
    t2.join();

    return 0;
}
